# Bu dosyayı keystore.properties olarak kopyalayın (repoya EKLEMEYİN, .gitignore'da).
# Keystore oluşturmak için:
#   keytool -genkey -v -keystore hava-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias hava
storeFile=hava-release.jks
storePassword=CHANGE_ME
keyAlias=hava
keyPassword=CHANGE_ME
